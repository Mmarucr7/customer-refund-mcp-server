{
  "name": "customer-refund-mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol server exposing customer lookup and refund tools over stdio with strict input validation.",
  "license": "MIT",
  "author": "Manthan <mmarucr7@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mmarucr7/customer-refund-mcp-server.git"
  },
  "homepage": "https://github.com/Mmarucr7/customer-refund-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/Mmarucr7/customer-refund-mcp-server/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "customer-refund-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "json-rpc",
    "stdio"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && vitest run",
    "test:coverage": "npm run build && vitest run --coverage",
    "inspector": "npx @modelcontextprotocol/inspector@2.13.0 node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "20.19.43",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
